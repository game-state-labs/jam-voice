"dur": 3.21,
"mouth": "12355553333333333215555554453335125555111223522222555555111111111",
"h": "c19b010b05"
},
{
"id": "b_test2",
"who": "b",
"tag": "test",
"text": "Hmm. I'd move the yellow one first. Just saying.",
"file": "clips/b_test2.mp3",
"dur": 2.38,
"mouth": "113453333555333333351235521112222255555111111111",
"h": "1ae0f56430"
},
{
"id": "b_test3",
"who": "b",
"tag": "test",
"text": "Fun fact! Nobody asked. Here it is anyway.",
