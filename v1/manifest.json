"dur": 2.35,
"mouth": "154333333253351222355552223113335122555522111111",
"h": "d6f1c67400"
},
{
"id": "p_test3",
"who": "p",
"tag": "test",
"text": "Peasants first, naturally. I shall exit last, in style.",
