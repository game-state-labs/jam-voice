"dur": 2.88,
"mouth": "1553333455114444455555552222223444451115544451111111111111",
"h": "6c208df26b"
},
{
"id": "g_test3",
"who": "g",
"tag": "test",
"text": "Five more minutes. Please.",
"file": "clips/g_test3.mp3",
"dur": 2.7,
"mouth": "111133333354444444444455511221111114555551111111111111",
"h": "106ae7e764"
},
{
"id": "y_test1",
"who": "y",
"tag": "test",
"text": "Ooh ooh ooh! Pick me! Pick me next!",
