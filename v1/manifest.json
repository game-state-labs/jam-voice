"dur": 2.24,
"mouth": "113322335133333555522111233325555555551111111",
"h": "4cb2b8a28a"
},
{
"id": "g_test1",
"who": "g",
"tag": "test",
"text": "Wake me up when it's my turn. Or don't. That's fine too.",
"file": "clips/g_test1.mp3",
"dur": 4.23,
"mouth": "1544335143334444512443551225344551111444413344111111155512222355555222555111111111111",
"h": "6391c63317"
},
{
"id": "g_test2",
"who": "g",
"tag": "test",
"text": "Ugh. Moving is so much work.",
